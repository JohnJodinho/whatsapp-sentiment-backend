# =================================================================
# Database Configuration
# =================================================================
# Direct DB Parameters (Fallback / Local PostgreSQL)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentiment_db

# Complete Database URI (e.g. Supabase Connection Pooler / Local Postgres)
DATABASE_URL=postgresql+asyncpg://postgres.your-project:your_db_password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# =================================================================
# Vector Database (ChromaDB / Chroma Cloud)
# =================================================================
# Mode: 'local' (Persistent SQLite+HNSW) or 'cloud' (Hosted Multi-Tenant)
CHROMA_MODE=local
CHROMA_COLLECTION_NAME=sentiment-scope
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Chroma Cloud Parameters (Required when CHROMA_MODE=cloud)
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=ck-your_chroma_cloud_api_key_here
CHROMA_TENANT=your_tenant_id_here
CHROMA_DATABASE=your_database_name_here

# =================================================================
# Groq LLM Multi-Model Engine
# =================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
GROQ_MODEL_ROUTER=qwen/qwen3.6-27b

# =================================================================
# Local CPU ONNX Inference Models
# =================================================================
SENTIMENT_MODEL_REPO=JohnAlbarkaIbrahim/afroxlmr-mini-nigerian-sentiment
SENTIMENT_MODEL_SUBFOLDER=v1/onnx_int8
SENTIMENT_MODEL_DIR=./models/sentiment_onnx_int8

EMBEDDING_MODEL_REPO=Davlan/afro-xlmr-mini
EMBEDDING_MODEL_DIR=./models/afro_mini_onnx_int8

# =================================================================
# Application State & Security
# =================================================================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
IS_CELERY_WORKER=false

# Security & JWT
SECRET_KEY=generate_a_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]

# =================================================================
# Celery & Redis Infrastructure
# =================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
